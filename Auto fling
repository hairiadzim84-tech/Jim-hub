local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local function LemparTerdekat()
    local Target, JarakMin = nil, math.huge
    if not LocalPlayer.Character then return end
    local Saya = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not Saya then return end

    for _, Plr in pairs(Players:GetPlayers()) do
        if Plr ~= LocalPlayer and Plr.Character then
            local Dia = Plr.Character:FindFirstChild("HumanoidRootPart")
            local Hum = Plr.Character:FindFirstChild("Humanoid")
            if Dia and Hum then
                local Jarak = (Saya.Position - Dia.Position).Magnitude
                if Jarak < JarakMin then
                    JarakMin = Jarak
                    Target = {Root = Dia, Hum = Hum}
                end
            end
        end
    end

    if not Target then return end
    Target.Hum.PlatformStand = true
    local Arah = (Target.Root.Position - Saya.Position).Unit
    Target.Root.Velocity = Arah * 800 + Vector3.new(0, 500, 0)
    task.wait(1.2)
    if Target.Hum then Target.Hum.PlatformStand = false end
end

local Gui = Instance.new("ScreenGui")
Gui.Parent = LocalPlayer:FindFirstChild("PlayerGui")
Gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

local Tombol = Instance.new("TextButton")
Tombol.Size = UDim2.new(0, 140, 0, 140)
Tombol.Position = UDim2.new(0.82, 0, 0.78, 0)
Tombol.BackgroundColor3 = Color3.fromRGB(220, 50, 50)
Tombol.Text = "💥 LEMPAR"
Tombol.TextColor3 = Color3.new(1,1,1)
Tombol.Font = Enum.Font.GothamBold
Tombol.TextScaled = true
Tombol.AutoLocalize = false
Tombol.Parent = Gui

Tombol.MouseButton1Down:Connect(function()
    Tombol.BackgroundColor3 = Color3.fromRGB(180, 30, 30)
    LemparTerdekat()
    task.wait(0.2)
    Tombol.BackgroundColor3 = Color3.fromRGB(220, 50, 50)
end)
